[Unit]
Description=Hermes English Tutor gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hermes/workspace/tutor-workspace
Environment=HERMES_HOME=/home/hermes/.hermes-tutor
Environment=GATEWAY_MULTIPLEX_PROFILES=false
EnvironmentFile=/home/hermes/.hermes-tutor/.env
ExecStartPre=/home/hermes/.hermes/hermes-agent/venv/bin/python /home/hermes/workspace/tutor/deploy/check_ready.py
ExecStart=/home/hermes/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run
Restart=on-failure
RestartSec=15
UMask=0077

[Install]
WantedBy=default.target
